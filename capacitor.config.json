{
  "appId": "com.mineplay.game",
  "appName": "MINEPLAY",
  "webDir": "www",
  "server": {
    "androidScheme": "https",
    "cleartext": false
  },
  "android": {
    "allowMixedContent": true,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "backgroundColor": "#1a0a2e",
      "androidSplashResourceName": "splash",
      "showSpinner": false
    }
  }
}
